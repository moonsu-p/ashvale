{
  "compilerOptions": {
    "target": "ES2022",
    // 미리보기 스크립트가 src/ 의 렌더러를 그대로 불러 쓴다.
    // 그 코드가 캔버스 타입을 참조하므로 DOM 도 함께 열어 둔다
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "scripts"]
}
